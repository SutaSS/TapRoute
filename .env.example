# ============================================================
# TapRoute — Environment Variables
# ============================================================
# Copy file ini ke .env dan isi dengan nilai yang sesuai
# cp .env.example .env

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# SQLite (untuk development):
DATABASE_URL="file:./dev.db"

# PostgreSQL (untuk production):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ------------------------------------------------------------
# LLM API Key (pilih salah satu)
# ------------------------------------------------------------

# Groq (gratis, cepat — RECOMMENDED untuk hackathon)
GROQ_API_KEY="your-groq-api-key-here"

# OpenAI
# OPENAI_API_KEY="your-openai-api-key-here"

# ------------------------------------------------------------
# Auth (jika pakai NextAuth)
# ------------------------------------------------------------
# NEXTAUTH_SECRET="generate-random-string-here"
# NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------
# App Config
# ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="TapRoute"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Platform fee percentage (default: 10)
PLATFORM_FEE_PERCENT=10
