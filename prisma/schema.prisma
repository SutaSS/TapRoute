// ============================================================
// TapRoute — Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// User
// ------------------------------------------------------------
model User {
  id String @id @db.Uuid

  // Relasi: Satu user punya banyak itineraries dan banyak bookings
  itineraries Itinerary[]
  bookings    Booking[]

  @@map("users") // Memaksa Prisma membaca/menulis ke tabel 'users' di DB
}

// ------------------------------------------------------------
// Itinerary
// ------------------------------------------------------------
model Itinerary {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  title              String
  location           String
  duration           Int
  budget             Int
  preferences        String[]
  itineraryJson      Json     @default("[]") @map("itinerary_json")
  totalEstimatedCost Int      @default(0) @map("total_estimated_cost")
  status             String   @default("draft") // draft | planned | paid | completed
  isFinal            Boolean  @default(false) @map("is_final")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relasi ke User dan Booking
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("itineraries") // Memaksa Prisma membaca/menulis ke tabel 'itineraries' di DB
}

// ------------------------------------------------------------
// Booking
// ------------------------------------------------------------
model Booking {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itineraryId String   @map("itinerary_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  placeName   String   @map("place_name")
  category    String   // destination | umkm
  price       Int
  platformFee Int      @map("platform_fee")
  umkmRevenue Int      @map("umkm_revenue")
  status      String   @default("pending") // pending | paid
  createdAt   DateTime @default(now()) @map("created_at")

  // Relasi ke Itinerary dan User
  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bookings") // Memaksa Prisma membaca/menulis ke tabel 'bookings' di DB
}