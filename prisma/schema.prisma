// ============================================================
// TapRoute — Prisma Schema
// ============================================================
// Sesuai Dbdiagram.MD:
//   - users  (id uuid, dari auth)
//   - itineraries (id uuid, user_id, title, location, duration, budget int,
//                  preferences text[], itinerary_json jsonb,
//                  total_estimated_cost int, status, is_final, timestamps)
//   - bookings (id uuid, itinerary_id, user_id, place_name, category,
//               price int, platform_fee int, umkm_revenue int, status, created_at)
//
// Note: package.json menunjukkan ^7.6.0 tapi node_modules berisi v6.19.2
//       Di Prisma v6, url wajib ada di datasource block.
// Jalankan: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// users
// id dari Supabase auth.users (uuid)
// ------------------------------------------------------------
model users {
  id String @id @db.Uuid

  itineraries itineraries[]
  bookings    bookings[]
}

// ------------------------------------------------------------
// itineraries
// status : draft | planned | paid | completed
// is_final: true setelah user klik "Done"
// itinerary_json: DayItinerary[] disimpan sebagai JSONB
// preferences: array of string (e.g. ["beach","culinary"])
// ------------------------------------------------------------
model itineraries {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String   @db.Uuid
  title                String
  location             String
  duration             Int
  budget               Int
  preferences          String[]
  itinerary_json       Json     @default("[]")
  total_estimated_cost Int      @default(0)
  status               String   @default("draft") // draft | planned | paid | completed
  is_final             Boolean  @default(false)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  user     users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  bookings bookings[]
}

// ------------------------------------------------------------
// bookings
// Dibuat saat user konfirmasi pembayaran
// platform_fee = 10% dari price
// umkm_revenue = 90% dari price
// status: pending | paid
// ------------------------------------------------------------
model bookings {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itinerary_id  String   @db.Uuid
  user_id       String   @db.Uuid
  place_name    String
  category      String   // destination | umkm
  price         Int
  platform_fee  Int      // 10% dari price
  umkm_revenue  Int      // 90% dari price
  status        String   @default("pending") // pending | paid
  created_at    DateTime @default(now())

  itinerary itineraries @relation(fields: [itinerary_id], references: [id], onDelete: Cascade)
  user      users       @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
